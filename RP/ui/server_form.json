{
  "namespace": "server_form",
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'echo:') = #title_text)", // We need to define the title we added on $title_needs_to_contain
            //By the way, you can also put the title on your forms as much as you want like this ->(#title_text -'form_1' - 'form_2' -'form_3'),
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "custom_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'echo:') = #title_text)", // We need to define the title we added on $title_needs_to_contain
            //By the way, you can also put the title on your forms as much as you want like this ->(#title_text -'form_1' - 'form_2' -'form_3'),
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "frost_chat_server_form_factory": {
              //Name can be anythin but server_form_factory
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@echo_chat.main_long_form_panel",
                  "custom_form": "@echo_chat.main_custom_form_panel"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
