{
  "namespace": "echo_chat_view",
  "echo_chat_view_panel": {
    "type": "panel",
    "size": [445, 250],
    "focus_container": true,
    "focus_change_left": "chat_text_input",
    "controls": [
      // title
      {
        "chat_list_title": {
          "type": "label",
          "text": "Chat View",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": ["50% - 30px", 0],
          "font_size": "large",
          "font_type": "MinecraftTen",
          "size": ["100%", 20],
          "color": [1, 1, 1],
          "layer": 2
        }
      },
      //background image
      {
        "background": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": ["100%", "100%"],
          "alpha": 0.6
        }
      },
      //close btn
      {
        "close_button_holder": {
          "type": "panel",
          "controls": [
            {
              "close@common.close_button": {
                "layer": 2,
                "offset": [0, 0]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#close_button_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      // chat messages panel
      {
        "chat_panel": {
          "type": "panel",

          "controls": [
            {
              "panel_bg": {
                "type": "image",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "texture": "textures/ui/Black",
                "alpha": 0.3,
                "size": ["100%", "90%"],
                "offset": [0, "10%"],
                "controls": [
                  // chats
                  {
                    "echo_chat_scroll_panel": {
                      "type": "stack_panel",
                      "size": ["100%", "85%"],

                      "offset": [2, 0],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "layer": 1,
                      "controls": [
                        {
                          "scrolling_panel@common.scrolling_panel": {
                            "type": "panel",
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "$show_background": false,
                            "size": ["100%", "100%"],
                            "$scrolling_content": "echo_chat_view.echo_chat_scrolling_content",
                            "$scroll_size": [5, "100%"],
                            "$scrolling_pane_size": ["100% - 4px", "100%"],
                            "$scrolling_pane_offset": [2, 0],
                            "$scroll_bar_right_padding_size": [0, 0],
                            "$jump_to_bottom_on_update": true
                          }
                        }
                      ]
                    }
                  },
                  // input field
                  {
                    "inputfield": {
                      "type": "collection_panel",
                      "collection_name": "custom_form",
                      "anchor_from": "bottom_left",
                      "size": ["75%", 32],
                      "offset": [1, -4],
                      "anchor_to": "bottom_left",
                      "layer": 2,

                      "controls": [
                        {
                          "input@echo_chat_view.custom_input": {
                            "collection_index": 0,
                            "focus": true

                            // These ensure that if focus resets, it lands back here
                          }
                        }
                      ]
                    }
                  },
                  //enter button
                  {
                    "submit_button@common_buttons.light_text_button": {
                      "$pressed_button_name": "button.submit_custom_form",
                      "anchor_from": "bottom_right",
                      "anchor_to": "bottom_right",
                      "offset": [-4, 0],
                      "size": ["20%", 32],
                      "$button_text": "Enter",
                      "$button_text_binding_type": "global",
                      "$button_binding_condition": "once",

                      "bindings": [
                        {
                          "binding_name": "#submit_button_visible",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "echo_chat_scrolling_content": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",

    "controls": [
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 0]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "echo_chat_scrolling_content@echo_chat_view.echo_chat_view_scrolling_content": {}
            }
          ]
        }
      }
    ]
  },
  "generated_contents": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",

    "factory": {
      "name": "buttons",
      "control_ids": {
        "label": "@echo_chat_view.reply_panel",
        "toggle": "@server_form.custom_toggle",
        "slider": "@server_form.custom_slider",
        "step_slider": "@server_form.custom_step_slider",
        "dropdown": "@server_form.custom_dropdown",
        "input": "@echo_chat_view.invisible_input_placeholder",
        "header": "@echo_chat_view.message_panel",
        "divider": "@settings_common.option_group_section_divider"
      }
    },

    "collection_name": "custom_form",
    "bindings": [
      {
        "binding_name": "#custom_form_length",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "echo_chat_view_scrolling_content": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "offset": [0, 0],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",

    "controls": [
      {
        "generated_form@echo_chat_view.generated_contents": {
          "controls": [
            // {
            //   "bg": {
            //     "type": "image",
            //     "texture": "textures/ui/White",
            //     "size": ["100%", "80%"],
            //     "anchor_from": "top_left",
            //     "anchor_to": "top_left",
            //     "alpha": 0.6
            //   }
            // }
          ]
        }
      }
    ]
  },

  "custom_input@settings_common.option_text_edit": {
    "$focus_id": "chat_text_input",
    "default_focus_precedence": 1,

    "$option_label": "#custom_text",
    "$option_place_holder_text": "#custom_placeholder_text",
    "$text_edit_box_placeholder_content_binding_name": "$option_place_holder_text",
    "$text_edit_box_placeholder_content_binding_type": "collection",
    "$text_edit_box_grid_collection_name": "custom_form",

    "$max_text_edit_length": 2000,

    "$text_edit_box_content_binding_type": "collection",
    "$text_edit_box_content_binding_name": "#custom_input_text",

    "$option_binding_name": "#custom_input_text",
    "$text_box_enabled_binding_name": "#custom_input_enabled",
    "$text_box_name": "custom_input",

    "$option_tooltip_binding_type": "collection",
    "$option_tooltip_collection_name": "custom_form",
    "$option_tooltip_text_binding_name": "#custom_tooltip_text",
    "$option_tooltip_area": "inside_header_panel",
    "$label_bindings": [
      {
        "binding_name": "#custom_text",
        "binding_type": "collection",
        "binding_collection_name": "custom_form"
      }
    ]
  },
  "reply_panel": {
    "type": "panel",
    "size": ["48%", "100%c"],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [-4, 0],
    "layer": 20,
    "controls": [
      {
        "padding": {
          "type": "panel",
          "size": ["100%", "10px"]
        }
      },
      {
        "reply": {
          "type": "image",
          "texture": "textures/ui/White",
          "size": ["100%", "100%c + 12px"],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [0, 0],
          "alpha": 0.2,
          "layer": 50,
          "controls": [
            {
              "custom_label@settings_common.option_group_label": {
                "$text": "#custom_text",
                "offset": [4, 2],
                "layer": 52,
                "hide_hyphen": true,
                "$text_bindings": [
                  {
                    "binding_name": "#custom_text",
                    "binding_type": "collection",
                    "binding_collection_name": "custom_form"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "message_panel": {
    "type": "panel",
    "size": ["48%", "100%c"],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [-10, 0],
    "layer": 20,
    "controls": [
      {
        "padding": {
          "type": "panel",
          "size": ["100%", "10px"]
        }
      },
      {
        "message": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": ["100%", "100%c"],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": ["100% + 4%", 0],
          "layer": 50,
          "alpha": 0.8,
          "controls": [
            {
              "custom_label@settings_common.option_group_label": {
                "$text": "#custom_text",
                "offset": [4, 2],
                "hide_hyphen": "true",
                "text_alignment": "right",
                "layer": 52,
                "$text_bindings": [
                  {
                    "binding_name": "#custom_text",
                    "binding_type": "collection",
                    "binding_collection_name": "custom_form"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "invisible_input_placeholder": {
    "type": "panel",
    "size": [0, 0]
  }
}
